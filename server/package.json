{
  "name": "bingo-battle-server",
  "version": "1.0.0",
  "description": "Realtime multiplayer Bingo Battle backend using Socket.IO",
  "main": "dist/server/src/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server/src/index.js",
    "dev": "nodemon --watch src --exec ts-node src/index.ts",
    "test": "jest --runInBand --detectOpenHandles"
  },
  "keywords": ["bingo", "multiplayer", "socket.io", "react-native"],
  "author": "Bingo Battle Team",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "socket.io-client": "^4.8.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
