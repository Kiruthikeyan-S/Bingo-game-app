{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": "../",
    "baseUrl": "./",
    "paths": {
      "@shared/*": ["../shared/*"],
      "zod": ["node_modules/zod"]
    }
  },
  "include": ["src/**/*", "tests/**/*", "../shared/**/*"]
}
